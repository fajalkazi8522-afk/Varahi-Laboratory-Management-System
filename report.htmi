<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Report Entry</title>
<link rel="stylesheet" href="css/style.css">
</head>
<body>

<div class="dashboard">

<h1>🧪 Report Entry</h1>

<input type="text" placeholder="Patient Name">

<select>
<option>Select Test</option>
<option>CBC</option>
<option>Blood Sugar</option>
<option>Urine Routine</option>
<option>LFT</option>
<option>KFT</option>
<option>Thyroid Profile</option>
<option>Widal</option>
<option>Dengue</option>
<option>HIV</option>
<option>HBsAg</option>
</select>

<textarea placeholder="Enter Report Details" rows="8"></textarea>

<button>💾 Save Report</button>

<button onclick="location.href='dashboard.html'">
⬅ Back
</button>

</div>

</body>
</html>
