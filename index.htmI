<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard - Varahi Laboratory</title>
<link rel="stylesheet" href="css/style.css">
</head>

<body>

<div class="dashboard">

<h1>🧪 Varahi Laboratory</h1>

<h2>Dashboard</h2>

<button onclick="location.href='patient.html'">👤 Patient Registration</button>

<button onclick="location.href='report.html'">📝 New Report</button>

<button onclick="location.href='billing.html'">💰 Billing</button>

<button>🔍 Patient Search</button>

<button>📋 Test Price List</button>

<button onclick="location.href='index.html'">🏠 Home</button>

</div>

