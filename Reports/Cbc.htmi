<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CBC Report</title>
<link rel="stylesheet" href="../css/style.css">
</head>
<body>

<div class="dashboard">

<h1>🩸 CBC Report</h1>

<input id="cbcName" type="text" placeholder="Patient Name">

<input id="hb" type="text" placeholder="Hemoglobin (Hb)">

<input id="wbc" type="text" placeholder="Total WBC">

<input id="rbc" type="text" placeholder="RBC Count">

<input id="platelet" type="text" placeholder="Platelet Count">

<input id="pcv" type="text" placeholder="PCV">

<input id="mcv" type="text" placeholder="MCV">
<input type="text" placeholder="Total WBC">

<input type="text" placeholder="RBC Count">

<input type="text" placeholder="Platelet Count">

<input type="text" placeholder="PCV">

<input type="text" placeholder="MCV">

<input id="mch" type="text" placeholder="MCH">

<input id="mchc" type="text" placeholder="MCHC">

<input id="neutrophils" type="text" placeholder="Neutrophils %">

<input id="lymphocytes" type="text" placeholder="Lymphocytes %">
<input type="text" placeholder="MCH">

<input type="text" placeholder="MCHC">

<button onclick="saveCBC()">💾 Save CBC Report</button>

<button onclick="viewCBC()">👁 View CBC Report</button>

<button onclick="window.print()">🖨 Print Report</button>

<hr>

<h2>CBC Report Preview</h2>

<table border="1" width="100%" cellpadding="8">
<tr>
<th>Test</th>
<th>Result</th>
<th>Normal Range</th>
</tr>

<tr>
<td>Hemoglobin</td>
<td id="showHb">-</td>
<td>13 - 17 g/dL</td>
</tr>

<tr>
<td>Total WBC</td>
<td id="showWbc">-</td>
<td>4000 - 11000 /cumm</td>
</tr>

<tr>
<td>RBC Count</td>
<td id="showRbc">-</td>
<td>4.5 - 5.5 million/cumm</td>
</tr>

<tr>
<td>Platelet Count</td>
<td id="showPlatelet">-</td>
<td>150000 - 450000 /cumm</td>
</tr>

</table>
<button onclick="location.href='../dashboard.html'">⬅ Back</button>

</div>

<script src="../js/script.js"></script>

</body>
</html>
